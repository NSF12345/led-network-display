# Copy to .env and fill in real values. .env is gitignored - never commit it.

# DEBUG | INFO | WARNING | ERROR | CRITICAL - DEBUG includes the
# per-poll RX/TX line (useful for troubleshooting, spammy long-term)
LOG_LEVEL=INFO

# --- Traffic source ---
# dummy = synthetic traffic, no SNMP target needed (default, use this for now)
# snmp  = poll a real device (fill in SNMP_* below, requires pysnmp installed)
TRAFFIC_SOURCE=dummy

DUMMY_RX_BASELINE_BYTES=200000
DUMMY_TX_BASELINE_BYTES=50000
DUMMY_SPIKE_CHANCE=0.08
DUMMY_SPIKE_MAX_BYTES=20000000

# --- SNMP target (only used when TRAFFIC_SOURCE=snmp) ---
SNMP_HOST=192.168.0.1
SNMP_PORT=161
SNMP_IF_INDEX=1

# v1/v2c = community string, no encryption - simpler to set up (v1 uses
#          older 32-bit counters - see README)
# v3     = USM auth+privacy (more setup, more secure) - the SNMP_USER/AUTH/PRIV
#          fields below are only required when SNMP_VERSION=v3
SNMP_VERSION=v2c

# --- v1 / v2c ---
SNMP_COMMUNITY=changeme

# --- v3 ---
SNMP_USER=changeme
SNMP_AUTH_PROTOCOL=SHA
SNMP_AUTH_PASSWORD=changeme
SNMP_PRIV_PROTOCOL=AES128
SNMP_PRIV_PASSWORD=changeme
SNMP_CONTEXT_NAME=

# --- Polling / rendering ---
POLL_INTERVAL_SECONDS=1.0
RENDER_FPS=24
LED_COUNT=180
RATE_SMOOTHING_ALPHA=0.3
RATE_SCALE_MIN_BYTES=1000
RATE_SCALE_MAX_BYTES=50000000
RX_COLOR=0,205,255
RX_HIGHLIGHT_COLOR=210,255,255
TX_COLOR=0,255,100
TX_HIGHLIGHT_COLOR=70,255,220
RX_PARTICLE_SPEED_PIXELS_PER_SEC=30.0
TX_PARTICLE_SPEED_PIXELS_PER_SEC=27.0
PARTICLE_SPEED_JITTER=0.10
PARTICLE_TRAIL_LENGTH=3.0
PARTICLE_MAX_PER_DIRECTION=24
STALE_DATA_TIMEOUT_SECONDS=3.0

# --- Web output (browser preview) ---
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --- WLED output (real hardware - leave disabled until you have a controller) ---
WLED_ENABLED=false
WLED_HOST=
WLED_PORT=21324
WLED_TIMEOUT_SECONDS=5
